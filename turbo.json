{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "//#check:resume:custom": {
      "dependsOn": ["//#lint:install"],
      "outputLogs": "errors-only"
    },
    "//#check:resume:resumed": {
      "dependsOn": ["//#lint:install"],
      "outputLogs": "errors-only"
    },
    "//#lint:format": {
      "dependsOn": ["//#lint:install"],
      "outputLogs": "errors-only"
    },
    "//#lint:install": {
      "inputs": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
    },
    "//#lint:issues": {
      "dependsOn": ["//#lint:install"],
      "outputLogs": "errors-only"
    },
    "//#lint:knip": {
      "dependsOn": ["//#lint:install"],
      "outputLogs": "errors-only"
    },
    "//#lint:repo": {
      "dependsOn": ["//#lint:install"],
      "inputs": ["$TURBO_DEFAULT$", "dist/**"]
    },
    "//#lint:types": {
      "dependsOn": ["//#lint:install"],
      "outputLogs": "errors-only"
    },
    "//#test:unit": {
      "dependsOn": ["//#lint:install"],
      "outputLogs": "errors-only",
      "outputs": ["coverage/**"]
    }
  }
}
